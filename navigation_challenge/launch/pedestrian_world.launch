<launch>
  <!-- ============================================================ -->
  <!-- Pedestrian World Launcher - I-RIM 2025 Challenge            -->
  <!-- Simple Office with Pedestrians                              -->
  <!-- ============================================================ -->
  
  <!-- GUI argument -->
  <arg name="gui" default="true"/>
  
  <!-- World and scenario file paths -->
  <arg name="world_file" value="$(find navigation_challenge)/worlds/simple_office_with_pedestrians.world"/>
  <arg name="scene_file" value="$(find navigation_challenge)/scenarios/simple_office_pedestrians.xml"/>
  
  <!-- Launch the navigation world with selected pedestrian scenario -->
  <include file="$(find navigation_challenge)/launch/navigation_world.launch">
    <arg name="world_name" value="$(arg world_file)"/>
    <arg name="scene_file" value="$(arg scene_file)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="generate_maze" value="false"/>
  </include>
  
  <!-- Info message about loaded world -->
  <node pkg="rostopic" type="rostopic" name="world_info" 
        args="pub -l /world_info std_msgs/String 'Loaded_world_simple_office'" 
        output="screen"/>
  
</launch>
